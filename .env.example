PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/what-do-you-think?retryWrites=true&w=majority
CLIENT_ORIGINS=http://localhost:3000,https://pooling-client.vercel.app
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-random-secret-with-at-least-32-characters
# Optional JSON array used for zero-downtime secret rotation. Put the newest
# secret first, for example: [{"version":2,"value":"new-secret"},{"version":1,"value":"old-secret"}]
BETTER_AUTH_SECRETS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=What Do You Think <sign-in@your-verified-domain.com>
ADMIN_EMAILS=you@example.com
MODERATOR_EMAILS=
